menu "wireless dap config"
    config USE_WEBSOCKET_DAP
        bool "Enable the websocket dap feature"

    choice DAP_TRANSPORT
        prompt "Transport to the host"
        default DAP_TRANSPORT_USB if IDF_TARGET_ESP32S3
        default DAP_TRANSPORT_WIFI_USBIP
        help
            USB: CMSIS-DAP v2 (WinUSB bulk) over the native USB of the ESP32-S3
            (GPIO19/GPIO20). No Wi-Fi is started. Works with pyOCD, OpenOCD, probe-rs.
            Wi-Fi USB/IP: original wireless-esp8266-dap mode (needs Wi-Fi settings below).

        config DAP_TRANSPORT_USB
            bool "USB (CMSIS-DAP v2, native USB, ESP32-S2/S3)"
            depends on IDF_TARGET_ESP32S3

        config DAP_TRANSPORT_WIFI_USBIP
            bool "Wi-Fi (USB/IP)"
    endchoice

    config DAP_USB_VID
        int "USB vendor ID (USB transport)"
        depends on DAP_TRANSPORT_USB
        default 12346
        help
            Default 0x303A (Espressif). Decimal.

    config DAP_USB_PID
        int "USB product ID (USB transport)"
        depends on DAP_TRANSPORT_USB
        default 16385
        help
            Default 0x4001. Decimal. Check it does not clash with the devkit's
            own USB-Serial-JTAG (0x1001) when both are plugged in.

    menu "Wi-Fi (used only in the Wi-Fi transport)"
        config DAP_WIFI_SSID
            string "Wi-Fi SSID"
            default ""
            help
                Network name. Empty value: the device does not connect to Wi-Fi.

        config DAP_WIFI_PASSWORD
            string "Wi-Fi password"
            default ""
            help
                Not stored in git: set it in menuconfig or in a local sdkconfig.
    endmenu

    menu "Target interface (ESP32-S3)"
        depends on IDF_TARGET_ESP32S3

        config DAP_PIN_SWDIO
            int "SWDIO GPIO (SPI MOSI)"
            default 5
            range 1 48
            help
                Free GPIO of the devkit. Forbidden: 0, 3, 45, 46 (strapping),
                19, 20 (native USB), 26..37 (flash/PSRAM). Checked at build time.
                11 is the IO_MUX pin of FSPID (fastest); other pins go through the
                GPIO matrix (see README-RU.md).

        config DAP_PIN_SWCLK
            int "SWCLK GPIO (SPI CLK)"
            default 4
            range 1 48
            help
                Same limits as SWDIO. 12 is the IO_MUX pin of FSPICLK.

        config DAP_PIN_NRESET
            int "nRESET GPIO"
            default 6
            range 1 48

        config DAP_PIN_TDO
            int "JTAG TDO GPIO (only for JTAG)"
            default 9
            range 1 48

        config DAP_PIN_TDI
            int "JTAG TDI GPIO (only for JTAG)"
            default 10
            range 1 48

        config DAP_PIN_NTRST
            int "JTAG nTRST GPIO (only for JTAG)"
            default 14
            range 1 48
    endmenu

    menu "Target voltage (VTref, ESP32-S3)"
        depends on IDF_TARGET_ESP32S3

        config DAP_VTREF_ENABLE
            bool "Measure the target supply on an ADC pin (VTref)"
            default y
            help
                Reads the target rail through ADC1 (12 dB attenuation, curve-fitting
                calibration), logs it and returns it to the host with the vendor
                command 0x80 (see tools/vtref.py).

        config DAP_PIN_VTREF
            int "VTref GPIO (ADC1)"
            depends on DAP_VTREF_ENABLE
            default 1
            range 1 10
            help
                ADC1 pin of the devkit: GPIO1..10 (channel = GPIO-1). Free on the
                YD-ESP32-S3 with the default SWD pins (4/5/6, JTAG 9/10/14): 1, 2, 7, 8.
                Same forbidden pins as the SWD pins (checked at build time).
                WITHOUT a divider the pin must not see more than 3.3 V.

        config DAP_VTREF_DIV_TOP_OHM
            int "Divider: resistor from the target rail to the pin, Ohm"
            depends on DAP_VTREF_ENABLE
            default 0
            help
                0 together with bottom 0 = no divider (default: the ADC measures up to
                3.3 V on its own). With a divider: mV = pin_mV * (top+bottom) / bottom.

        config DAP_VTREF_DIV_BOTTOM_OHM
            int "Divider: resistor from the pin to GND, Ohm"
            depends on DAP_VTREF_ENABLE
            default 0
            help
                0 = no divider.

        config DAP_VTREF_FULLSCALE_MV
            int "Fallback full scale at 12 dB, mV"
            depends on DAP_VTREF_ENABLE
            default 3100
            help
                Used ONLY when the chip has no calibration scheme (linear fallback).

        config DAP_VTREF_SAMPLES
            int "ADC samples averaged per measurement"
            depends on DAP_VTREF_ENABLE
            default 16
            range 1 64

        config DAP_VTREF_LOG_PERIOD_MS
            int "VTref log period, ms (0 = log only at start)"
            depends on DAP_VTREF_ENABLE
            default 2000
            range 0 600000

        config DAP_VTREF_NONE_BELOW_MV
            int "Below this, the target is considered unpowered, mV"
            depends on DAP_VTREF_ENABLE
            default 1200
            help
                Threshold SETTING: tune for the object (a 1.8 V target may sag to 1.62 V).

        config DAP_VTREF_DIRECT_MIN_MV
            int "From this, the target is 3.3 V (direct connection), mV"
            depends on DAP_VTREF_ENABLE
            default 2700

        config DAP_VTREF_OVER_MV
            int "From this, the target is too high for 3.3 V pins, mV"
            depends on DAP_VTREF_ENABLE
            default 3600
    endmenu

    config DAP_SWD_CLOCK_HZ
        int "Default SWD/JTAG clock, Hz"
        default 1000000
        range 1000 40000000
        help
            Clock used until the host sets its own with DAP_SWJ_Clock.
            Default 1 MHz (not higher: a long wire or a level shifter will not keep up).
endmenu
